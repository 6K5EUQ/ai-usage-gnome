<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.claude-usage"
          path="/org/gnome/shell/extensions/claude-usage/">

    <key name="refresh-interval" type="i">
      <default>600</default>
      <range min="60" max="3600"/>
      <summary>Refresh interval (seconds)</summary>
      <description>How often to poll the usage endpoint. Low values risk HTTP 429 rate limiting.</description>
    </key>

    <key name="high-threshold" type="i">
      <default>80</default>
      <range min="1" max="100"/>
      <summary>Red threshold (percent)</summary>
      <description>Color the value red at or above this utilization percentage.</description>
    </key>

    <key name="show-five-hour" type="b">
      <default>true</default>
      <summary>Show 5-hour usage</summary>
    </key>

    <key name="show-seven-day" type="b">
      <default>true</default>
      <summary>Show 7-day usage</summary>
    </key>

    <key name="credentials-path" type="s">
      <default>''</default>
      <summary>Credentials file path</summary>
      <description>Path to the Claude credentials JSON. Empty means ~/.claude/.credentials.json.</description>
    </key>

  </schema>
</schemalist>
